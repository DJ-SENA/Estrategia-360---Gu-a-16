# =========================================================================
# SENA EstrategIA 360 - Variables de Entorno y Configuración de Despliegue
# =========================================================================

# GEMINI_API_KEY: Requerida para análisis y articulación estratégica asistida por IA.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública de la aplicación.
APP_URL="MY_APP_URL"

# INSTRUCTOR_PASSWORD: Clave criptográfica para autenticación exclusiva del perfil Instructor.
# OBLIGATORIA EN PRODUCCIÓN. Si no se define, el sistema opera en modo demostración aislado (DEMO_MODE).
INSTRUCTOR_PASSWORD="DEFINE_CLAVE_SEGURA_INSTRUCTOR_SENA"

# DEMO_INSTRUCTOR_PASSWORD: Clave opcional de demostración para pruebas locales.
# DEMO_INSTRUCTOR_PASSWORD="DemoInstructor2026*"

# -------------------------------------------------------------------------
# AUTENTICACIÓN INSTITUCIONAL SENA - MICROSOFT ENTRA ID (OPENID CONNECT)
# Pendiente de autorización por la Dirección General / Oficina de Sistemas SENA
# -------------------------------------------------------------------------
# AZURE_ENTRA_TENANT_ID="cb8b23a9-..."
# AZURE_ENTRA_CLIENT_ID="9a1b2c3d-..."
# AZURE_ENTRA_CLIENT_SECRET="secret-value"
# AZURE_ENTRA_REDIRECT_URI="https://estrategia360.sena.edu.co/api/auth/entra/callback"

# -------------------------------------------------------------------------
# PERSISTENCIA EN NUBE / VERCEL SERVERLESS (POSTGRESQL - NEON / SUPABASE)
# Requerida para sustituir el almacenamiento local projects-db.json en Vercel
# -------------------------------------------------------------------------
# DATABASE_URL="postgresql://usuario:password@ep-host.region.neon.tech/sena_estrategia360?sslmode=require"
